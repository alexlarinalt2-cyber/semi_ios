local function scanFriendPlots()
if not tpOnFriendsAllowEnabled then return end

-- Only check the adjacent plot (same one Auto TP On Unlock uses)
local adjPlot = getAdjacentPlot()
if not adjPlot then return end

local panel = adjPlot:FindFirstChild("FriendPanel")
if panel then
local imageLabel = panel:FindFirstChild("Main", true)
if imageLabel then
imageLabel = imageLabel:FindFirstChild("ImageLabel", true)
end

if imageLabel then
local isAllowed = (imageLabel.Image == OPENED_ID)
local wasAllowed = plotStates[adjPlot]

updateBillboard(adjPlot, isAllowed)

-- Trigger TP when:
-- 1. Plot becomes allowed (OFF -> ON transition)
-- 2. Plot is already allowed and we just enabled the feature (wasAllowed is nil)
if isAllowed and (not wasAllowed or wasAllowed == nil) then
if tick() - lastFriendTpTime >= friendTpCooldown then
lastFriendTpTime = tick()
plotStates[adjPlot] = isAllowed
print("🟢 Adjacent plot " .. adjPlot.Name .. " friends allowed! Auto-TPing...")
task.wait(0.5)
doSemiInstantSteal()
return
end
end

plotStates[adjPlot] = isAllowed
end
end
end

-- Start friend plot scanner
task.spawn(function()
while true do
scanFriendPlots()
task.wait(0.1)
end
end)


task.spawn(function()
if not player.Character then player.CharacterAdded:Wait() end
local snipeTpFired = false
while true do
task.wait(0.25)
if not autoTpOnUnlockEnabled then snipeTpFired = false continue end

local adjPlot = getAdjacentPlot()
if not adjPlot then
print("⚠️ Auto TP On Unlock: no adjacent plot found")
snipeTpFired = false continue
end
local char = player.Character
local hrp = char and char:FindFirstChild("HumanoidRootPart")
local spawn = adjPlot:FindFirstChild("Spawn")
local dist = (hrp and spawn) and (spawn.Position - hrp.Position).Magnitude or nil
print("🔍 Auto TP On Unlock: scanning " .. adjPlot.Name .. " (dist=" .. (dist and tostring(math.floor(dist)) or "?") .. ")")

local timerText = nil
for _, obj in ipairs(adjPlot:GetDescendants()) do
if obj:IsA("TextLabel") then
local t = obj.Text or ""
if t ~= "" and (t:match("^%d+s$") or t:match("^%d+:%d+$") or t:match("^%s*%d+%s*$")) then
timerText = t
local parts = {}
local cur = obj
while cur and cur ~= workspace do
table.insert(parts, 1, '["' .. cur.Name .. '"]')
cur = cur.Parent
end
print("🎯 Timer label: workspace" .. table.concat(parts) .. ' = "' .. t .. '"')
break
end
end
end
if not timerText then snipeTpFired = false continue end

local secs = parseRemainingSeconds(timerText)
if secs <= 1 and not snipeTpFired then
snipeTpFired = true
print("🎯 Auto TP On Unlock FIRING: " .. adjPlot.Name)
task.spawn(function()
task.wait(1.3)
doSemiInstantSteal()
task.wait(10) -- cooldown before allowing next fire
snipeTpFired = false
end)
elseif secs > 3 then
snipeTpFired = false
end
end
end)


