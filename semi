local function parseRemainingSeconds(text)
local m, s = text:match("(%d+):(%d+)")
if m and s then return tonumber(m) * 60 + tonumber(s) end
local ns = text:match("(%d+)s")
if ns then return tonumber(ns) end
local n = tonumber(text:match("^%s*(%d+)%s*$"))
if n then return n end
return math.huge
end


