if not adminRemote or not plotKey then return end
local hrp = getHRP()
if not hrp then return end
local myPos = hrp.Position
local closest, closestDist = nil, math.huge
for _, p in ipairs(Players:GetPlayers()) do
if p ~= player and p.Character then
local phrp = p.Character:FindFirstChild("HumanoidRootPart")
if phrp then
local dist = (phrp.Position - myPos).Magnitude
if dist < closestDist then closestDist = dist closest = p end
end
end
end
if closest then
print("💥 AP on: " .. closest.Name)
pcall(function()
for cmd, enabled in pairs(apSpamCommands) do
if enabled then
adminRemote:InvokeServer(plotKey, closest, cmd)
end
end
end)
end
end


