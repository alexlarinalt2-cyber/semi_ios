equipFlyingCarpet()
teleportWithTool()
end)
else
removeBeam()
if beamUpdateConnection then beamUpdateConnection:Disconnect() beamUpdateConnection = nil end
if proximityConnection then proximityConnection:Disconnect() proximityConnection = nil end
end
end


