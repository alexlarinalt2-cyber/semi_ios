local function applyToggleVisual(btn, stroke, label, state, onText, offText)
if state then
label.Text = onText
btn.BackgroundColor3 = ON
stroke.Color = ON_S
stroke.Transparency = 0
else
label.Text = offText
btn.BackgroundColor3 = BTN
stroke.Color = OFF_S
stroke.Transparency = 0.4
end
end


