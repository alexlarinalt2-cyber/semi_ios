local semiInProgress = false

local function getMyPlotPos()
local Plots = workspace:FindFirstChild("Plots")
if not Plots then return nil end
for _, plot in ipairs(Plots:GetChildren()) do
if isMyPlot(plot) then
local sign = plot:FindFirstChild("PlotSign")
if sign then return sign.Position end
local part = plot:FindFirstChildWhichIsA("BasePart")
if part then return part.Position end
end
end
return nil
end

local function isBase1()
local pos = getMyPlotPos()
if not pos then return true end
local ref1 = Vector3.new(-328, -7, 157)
local ref2 = Vector3.new(-321, -7, -31)
return (pos - ref1).Magnitude < (pos - ref2).Magnitude
end

local function getClosestStealPodium()
local hrp = getHRP()
if not hrp then return nil end
local Plots = workspace:FindFirstChild("Plots")
if not Plots then return nil end
local best, bestDist = nil, math.huge
for _, plot in ipairs(Plots:GetChildren()) do
if not plot:GetAttribute("Tier") then continue end
if isMyPlot(plot) then continue end
local podiums = plot:FindFirstChild("AnimalPodiums")
if not podiums then continue end
for _, num in ipairs({"1", "10"}) do
local podium = podiums:FindFirstChild(num)
if not podium then continue end
local prompt = findPromptInPodium(podium)
local claim = podium:FindFirstChild("Claim") and podium.Claim:FindFirstChild("Main")
if claim and prompt and prompt.ActionText == "Steal" then
local dist = (hrp.Position - claim.Position).Magnitude
if dist < bestDist then
bestDist = dist
best = { position = claim.Position, prompt = prompt }
end
end
end
end
return best
end

