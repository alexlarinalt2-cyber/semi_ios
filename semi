local function checkAuth()
    print("🔐 Checking authentication...")
   
    -- Fetch whitelist from Gist
    local success, response = pcall(function()
        return game:HttpGet(AUTH_URL)
    end)
   
    if not success then
        warn("❌ Failed to fetch whitelist!")
        player:Kick("\n🔒 SF Hub - Auth Error\n\nCould not connect to auth server.\nPlease try again later.")
        return false
    end
   
    -- Parse JSON
    local ok, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)
   
    if not ok then
        warn("❌ Failed to parse whitelist!")
        player:Kick("\n🔒 SF Hub - Auth Error\n\nInvalid auth data format.")
        return false
    end
   
    -- Check FreeForAll
    if data.FreeForAll == true then
        print("✅ Free for all mode - access granted!")
        sendWebhookLog("ffa", "Free For All Mode")
        return true
    end
   
    -- Check whitelist
    if not data.WhitelistedUsers then
        player:Kick("\n🔒 SF Hub - Not Whitelisted\n\nYour username is not on the whitelist.\nContact support: discord.gg/PTXPzbmvyA")
        return false
    end
   
    local username = player.Name
    local access = data.WhitelistedUsers[username]
   
    if not access then
        player:Kick("\n🔒 SF Hub - Not Whitelisted\n\nUsername: " .. username .. "\n\nYou are not on the whitelist.\nContact support: discord.gg/PTXPzbmvyA")
        return false
    end
   
    -- Check if permanent
    if access == "perm" then
        print("✅ Permanent access granted for: " .. username)
        sendWebhookLog("perm", "Permanent")
        return true
    end
   
    -- Check expiry date
    local expiryTimestamp = parseDate(access)
    if not expiryTimestamp then
        warn("❌ Invalid date format for user: " .. username)
        player:Kick("\n🔒 SF Hub - Invalid Access Date\n\nPlease contact support.")
        return false
    end
   
    local currentTime = os.time()
   
    if currentTime > expiryTimestamp then
        -- Expired
        player:Kick("\n🔒 SF Hub - Access Expired\n\nYour access expired on: " .. access .. "\n\nContact support to renew: discord.gg/PTXPzbmvyA")
        return false
    else
        -- Valid access
        local daysLeft = math.floor((expiryTimestamp - currentTime) / 86400)
        print("✅ Access granted for: " .. username .. " (Expires: " .. access .. ", " .. daysLeft .. " days left)")
        sendWebhookLog("temp", access .. " (" .. daysLeft .. " days left)")
        return true
    end
end

